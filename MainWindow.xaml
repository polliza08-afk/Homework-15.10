<Window x:Class="ExampleCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExampleCalculator"
        mc:Ignorable="d"
        Title="Калькулятор" Height="520" Width="360"
        MinHeight="520" MinWidth="360"
        MaxHeight="720" MaxWidth="600"
        Background="#FF202020">
    <DockPanel Margin="8">
        <TextBox x:Name="txtResult"
            DockPanel.Dock="Top"
                 Text="0"
                 FontSize="40"
                 FontWeight="Bold"
                 Background="Transparent"
                 Foreground="White"
                 BorderThickness="0"
                 HorizontalContentAlignment="Right"
                 VerticalContentAlignment="Center"
                 Height="100"
                 Margin="0,0,0,10"
                 IsReadOnly="True"/>

        <Grid Background="#FF202020">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Button Grid.Column="0" Grid.Row="0" 
                    Margin="2" Background="#FF2D2D2D" 
                    Foreground="White" FontSize="16">
                <Button.Content>
                    <TextBlock>%</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="1" Grid.Row="0" 
                    Margin="2" Background="#FF2D2D2D" 
                    Foreground="White" FontSize="16" Click="Button_Clear_Click">
                <Button.Content>
                    <TextBlock>CE</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="2" Grid.Row="0" Margin="2" 
                    Background="#FF2D2D2D" Foreground="White" 
                    Click="Button_Clear_Click"
                    FontSize="16">
                <Button.Content>
                    <TextBlock>C</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="3" Grid.Row="0" Margin="2" 
                    Background="#FF2D2D2D" Foreground="White" 
                    FontSize="16" Click="Button_Backspace_Click">
                <Button.Content>
                    <TextBlock>⌫</TextBlock>
                </Button.Content>
            </Button>

            <Button Grid.Column="0" Grid.Row="1" Margin="2" 
                    Background="#FF2D2D2D" Foreground="White" 
                    FontSize="16">
                <Button.Content>
                    <TextBlock>¹/ₓ</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="1" Grid.Row="1" 
                    Margin="2" Background="#FF2D2D2D" 
                    Foreground="White" FontSize="16">
                <Button.Content>
                    <TextBlock>x²</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="2" Grid.Row="1" Margin="2" 
                    Background="#FF2D2D2D" Foreground="White" 
                    FontSize="16">
                <Button.Content>
                    <TextBlock>²√x</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="3" Grid.Row="1" Margin="2" 
                    Background="#FF2D2D2D" Foreground="White"
                    FontSize="16">
                <Button.Content>
                    <TextBlock>÷</TextBlock>
                </Button.Content>
            </Button>

            <Button Grid.Column="0" Grid.Row="2" Margin="2" 
                    Background="#FF3B3B3B" Foreground="White" 
                    Click="Button_Digital_Click"
                    FontSize="18">
                <Button.Content>
                    <TextBlock>7</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="1" Grid.Row="2" Margin="2" 
                    Background="#FF3B3B3B" Foreground="White" 
                    Click="Button_Digital_Click"
                    FontSize="18">
                <Button.Content>
                    <TextBlock>8</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="2" Grid.Row="2" Margin="2" 
                    Background="#FF3B3B3B" Foreground="White" 
                    Click="Button_Digital_Click"
                    FontSize="18">
                <Button.Content>
                    <TextBlock>9</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="3" Grid.Row="2" Margin="2" 
                    Background="#FF2D2D2D" Foreground="White" 
                    FontSize="18">
                <Button.Content>
                    <TextBlock>×</TextBlock>
                </Button.Content>
            </Button>

            <Button Grid.Column="0" Grid.Row="3" Margin="2" 
                    Background="#FF3B3B3B" Foreground="White" 
                    Click="Button_Digital_Click"
                    FontSize="18">
                <Button.Content>
                    <TextBlock>4</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="1" Grid.Row="3" Margin="2" 
                    Background="#FF3B3B3B" Foreground="White" 
                    Click="Button_Digital_Click"
                    FontSize="18">
                <Button.Content>
                    <TextBlock>5</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="2" Grid.Row="3" Margin="2" 
                    Background="#FF3B3B3B" Foreground="White" 
                    Click="Button_Digital_Click"
                    FontSize="18">
                <Button.Content>
                    <TextBlock>6</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="3" Grid.Row="3" Margin="2" 
                    Background="#FF2D2D2D" Foreground="White" 
                    FontSize="18">
                <Button.Content>
                    <TextBlock>−</TextBlock>
                </Button.Content>
            </Button>

            <Button Grid.Column="0" Grid.Row="4" Margin="2" 
                    Background="#FF3B3B3B" Foreground="White" 
                    Click="Button_Digital_Click"
                    FontSize="18">
                <Button.Content>
                    <TextBlock>1</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="1" Grid.Row="4" Margin="2" 
                    Background="#FF3B3B3B" Foreground="White" 
                    Click="Button_Digital_Click"
                    FontSize="18">
                <Button.Content>
                    <TextBlock>2</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="2" Grid.Row="4" Margin="2"
                    Background="#FF3B3B3B" Foreground="White" 
                    Click="Button_Digital_Click"
                    FontSize="18">
                <Button.Content>
                    <TextBlock>3</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="3" Grid.Row="4" Margin="2" 
                    Background="#FF2D2D2D" Foreground="White" 
                    FontSize="18">
                <Button.Content>
                    <TextBlock>+</TextBlock>
                </Button.Content>
            </Button>

            <Button Grid.Column="0" Grid.Row="5" Margin="2" 
                    Background="#FF3B3B3B" Foreground="White" 
                    FontSize="16">
                <Button.Content>
                    <TextBlock>+/-</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="1" 
                    Grid.Row="5"
                    Click="Button_Digital_Click"
                    Margin="2" 
                    Background="#FF3B3B3B" 
                    Foreground="White" 
                    FontSize="18">
                <Button.Content>
                    <TextBlock>0</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="2" Grid.Row="5" Margin="2" 
                    Background="#FF3B3B3B" Foreground="White" 
                    FontSize="18">
                <Button.Content>
                    <TextBlock>,</TextBlock>
                </Button.Content>
            </Button>
            <Button Grid.Column="3" Grid.Row="5" Margin="2" 
                    Background="#FF76B9ED" Foreground="Black" 
                    FontSize="18" FontWeight="Bold">
                <Button.Content>
                    <TextBlock>=</TextBlock>
                </Button.Content>
            </Button>

        </Grid>
    </DockPanel>
</Window>